[TEMPLATE]
# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# 1 = демо-режим (не ходит в сеть, выдуманные данные), 0 = реальный API WB
WB_DEMO_MODE=0

# Периодичность проверки цен в минутах (раз в сутки = 1440)
WB_CHECK_INTERVAL_MINUTES=1440

# Порог остатка для уведомления "товар заканчивается"
WB_LOW_STOCK_THRESHOLD=5

# --- Антибот-обход (см. README) ---
# Транспорт: curl_cffi (имитация Chrome, по умолчанию) | httpx
WB_HTTP_CLIENT=curl_cffi

# Прокси для запросов к WB, если ваш IP заблокирован (403 на card.wb.ru).
# Примеры: http://user:pass@host:port | socks5://host:1080
WB_PROXY=

# Сколько попыток на 429/5xx/сетевые ошибки
WB_MAX_RETRIES=3

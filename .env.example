[TEMPLATE]
# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# 1 = демо-режим (не ходит в сеть) | 0 = реальный API Wildberries
WB_DEMO_MODE=1

# --- Антибот-обход ---
# curl_cffi (имитация Chrome, по умолчанию) | httpx
WB_HTTP_CLIENT=curl_cffi
# Прокси с «чистым» IP: http://user:pass@host:port или socks5://host:1080
WB_PROXY=
WB_MAX_RETRIES=3

# --- Продвинутые настройки ---
# Проверка цен раз в N минут (ТЗ: раз в сутки = 1440)
WB_CHECK_INTERVAL_MINUTES=1440
# Кулдаун уведомлений по одному товару (часы)
WB_ALERT_COOLDOWN_HOURS=6
# Хранить историю цен N дней
WB_HISTORY_KEEP_DAYS=30
# Минимальный интервал между сообщениями пользователя (секунды)
WB_THROTTLE_MIN_INTERVAL=0.7
# ID администраторов для /cleanup (через запятую; пусто = доступно всем)
WB_ADMIN_IDS=
# TTL кэша карточек WB (секунды)
WB_CACHE_TTL_SECONDS=300
